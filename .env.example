# --- Providers -------------------------------------------------------------
# Free key from https://openrouter.ai/keys (optional if you only use Ollama)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama runs models locally for free: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Cache -----------------------------------------------------------------
CACHE_TTL_SECONDS=86400
CACHE_MAX_TEMPERATURE=0.3
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_THRESHOLD=0.85
SEMANTIC_MAX_MESSAGES=4

# --- Router (used when model = "tokensaver/auto") --------------------------
ROUTER_CHEAP_MODEL=ollama/gemma3:4b
ROUTER_STRONG_MODEL=ollama/gemma3:12b
ROUTER_MODE=classifier   # rules | classifier

# --- Storage ---------------------------------------------------------------
DB_PATH=tokensaver.db
